DEEPGRAM_API_KEY=
FAL_KEY=
# Optional: a model available through fal's OpenRouter router
FAL_LLM_MODEL=google/gemini-2.5-flash
# Optional: fal image-to-video model for moving scenes, or "off" to keep still pictures
FAL_VIDEO_MODEL=minimax/h3-max-turbo/image-to-video
# Optional: baseline Flux TTS expressivity for story narration, -2 (calm) to 2 (animated); each line's mood shifts from it. Beta; 0 is Deepgram's validated default
DEEPGRAM_TTS_EXPRESSIVITY=1
